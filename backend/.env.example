# POLARIS Environment Configuration
# Open-Meteo works without API keys. Optional APIs can be configured below.

OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
NASA_POWER_API_KEY=
LLM_API_KEY=
LLM_PROVIDER=local_deterministic # options: local_deterministic, ollama, openai
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
REPLIT_WEBHOOK_URL=http://localhost:3000/api/sos-webhook
ENVIRONMENT=production
PORT=8000
HOST=0.0.0.0
